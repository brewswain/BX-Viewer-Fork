videos/*
playlists/*

# Import staging dir — removed in a `finally`, so this only catches a hard crash.
.tmp-import-*

# Test fixtures. Kept in the repo rather than %TEMP% because that is on the
# system volume, where Defender scans every new file (~0.5s each here).
.tmp-test-*

# Next.js / bun
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.env*.local

# bun.lock IS committed — this is an app, so installs should be reproducible.
# It cannot be regenerated on an exFAT volume (see README/launcher notes); use
# an NTFS checkout to refresh it.
bun.lockb
